@using System.Reflection
@using Microsoft.AspNetCore.Components.Web

<HeadContent>
    @* <link href="_content/KeHoachSX.UI/KeHoachSX.UI.bundle.scp.css" rel="stylesheet" /> *@
   @*  <link href="_content/KeHoachSX.UI/KeHoachSX.UI.bundle.scp.css" rel="stylesheet" /> *@
</HeadContent>

<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="new[] { typeof(JtecShare.UI.Login.Login).Assembly, typeof(KeHoachSX.UI.Pages.KeHoachSXWorkspace).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Lỗi 404</PageTitle>
        <div style="padding: 20px;">
            <p>Không tìm thấy màn hình bạn yêu cầu.</p>
        </div>
    </NotFound>
</Router>
